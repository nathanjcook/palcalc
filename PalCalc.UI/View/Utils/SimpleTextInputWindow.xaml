<adonisControls:AdonisWindow x:Class="PalCalc.UI.View.Utils.SimpleTextInputWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
                             xmlns:vu="clr-namespace:PalCalc.UI.View.Utils"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             mc:Ignorable="d"
                             DataContext="{Binding RelativeSource={RelativeSource Self}}"
                             WindowStyle="ToolWindow"
                             WindowStartupLocation="CenterOwner"
                             SizeToContent="Height"
                             IconVisibility="Collapsed"
                             Title="SimpleTextInputWindow"
                             Height="Auto" Width="300"
                             >
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- label sits above the input and wraps, so a long label doesn't squeeze the input box -->
        <TextBlock Grid.Row="0" Text="{Binding InputLabel}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="10,10,10,4" VerticalAlignment="Center"/>
        <TextBox x:Name="m_TextBox" Grid.Row="1" PreviewKeyDown="m_TextBox_PreviewKeyDown" Margin="10,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <!-- shown instead of m_TextBox when IsMasked; PasswordBox.Password can't be bound, so Result is updated from PasswordChanged -->
        <PasswordBox x:Name="m_PasswordBox" Grid.Row="1" PreviewKeyDown="m_TextBox_PreviewKeyDown" PasswordChanged="m_PasswordBox_PasswordChanged" Margin="10,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" vu:StackPanelExtensions.Spacing="6" Margin="5,8,11,8">
            <Button Content="{itl:LocalizedText Code=LC_COMMON_SAVE}" Command="{Binding SaveCommand}" />
            <Button Content="{itl:LocalizedText Code=LC_COMMON_CANCEL}" Command="{Binding CancelCommand}" />
        </StackPanel>

    </Grid>
</adonisControls:AdonisWindow>
